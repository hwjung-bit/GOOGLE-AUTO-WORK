# Database
DATABASE_URL="postgresql://gaw:gawpassword@localhost:5432/gaw_db"

# Redis
REDIS_URL="redis://localhost:6379"

# Google OAuth 2.0
# https://console.cloud.google.com/apis/credentials 에서 생성
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/callback"

# Gmail Push Notifications (Google Cloud Pub/Sub)
# https://console.cloud.google.com/cloudpubsub/topic/list 에서 생성
GMAIL_PUBSUB_TOPIC="projects/YOUR_PROJECT_ID/topics/gmail-notifications"

# Session Secret (최소 32자 이상의 랜덤 문자열)
# 생성: openssl rand -base64 32
SESSION_SECRET="your-session-secret-minimum-32-characters-long"

# Token Encryption Key (반드시 64자리 hex = 32 bytes)
# 생성: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY="your-64-character-hex-encryption-key-here-replace-this"

# Google Gemini API
# https://aistudio.google.com/app/apikey 에서 생성
GEMINI_API_KEY="your-gemini-api-key"

# App
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
